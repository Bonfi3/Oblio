# Solana RPC endpoint (devnet). Copy to .env.local and add your private RPC URL.
NEXT_PUBLIC_RPC_URL=https://api.devnet.solana.com

# Optional: RPC used by the server route (defaults to NEXT_PUBLIC_RPC_URL).
# RPC_URL=

# Treasury keypair (base58 secret key). Server-only: never prefix with NEXT_PUBLIC_.
# It is the obSOL mint authority and pays out SOL on unstake.
TREASURY_SECRET_KEY=
